+// [serveur] groupe de 6 : membre que le jeu de receiver ne peut pas afficher (un compagnon de préférence, le dernier arrivé sinon).
+// Les compagnons n'ont pas de jeu : ils reçoivent la liste complète.
+ObjectGuid Group::GetHiddenMemberFor(ObjectGuid receiver) const
+{
+    if (m_groupFlags != GROUP_FLAG_NORMAL || m_memberSlots.size() <= MAX_GROUP_SIZE)
+        return ObjectGuid();
+    Player* moi = sObjectMgr.GetPlayer(receiver);
+    if (moi && gCpgEstCompagnon && gCpgEstCompagnon(moi))
+        return ObjectGuid();
+    ObjectGuid compagnon, dernier;
+    for (member_citerator itr = m_memberSlots.begin(); itr != m_memberSlots.end(); ++itr)
+    {
+        if (itr->guid == receiver)
+            continue;
+        dernier = itr->guid;
+        Player* m = sObjectMgr.GetPlayer(itr->guid);
+        if (m && gCpgEstCompagnon && gCpgEstCompagnon(m))
+            compagnon = itr->guid;
+    }
+    return compagnon ? compagnon : dernier;
+}
