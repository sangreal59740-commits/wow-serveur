<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Launcher</AssemblyName>
    <Nullable>disable</Nullable>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WV2>$(NuGetPackageRoot)microsoft.web.webview2/1.0.2903.40/</WV2>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- un seul exe : les dll de WebView2 sont embarquées et extraites au premier lancement -->
    <EmbeddedResource Include="$(WV2)lib/net462/Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(WV2)lib/net462/Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(WV2)runtimes/win-x64/native/WebView2Loader.dll" LogicalName="WebView2Loader.dll" />
  </ItemGroup>
</Project>
